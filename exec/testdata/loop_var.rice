# Per-iteration loop variables (Go 1.22-style)
# Closures capture the iteration's binding, not a single loop-wide cell.

const callAll = func(fns) {
    var out = list.new();
    var k = 0;
    for k < len(fns) {
        out.append(fns[k]());
        k++;
    }
    return out;
};

const same = func(got, want) {
    if len(got) != len(want) {
        return false;
    }
    var k = 0;
    for k < len(got) {
        if got[k] != want[k] {
            return false;
        }
        k++;
    }
    return true;
};

var ok = true;

# --- C-style: closures capture this iteration's i (not the final i) ---
var cstyleFns = list.new();
for (var i = 0; i < 3; i++) {
    cstyleFns.append(func() { return i; });
}
ok = ok && same(callAll(cstyleFns), list.of(0, 1, 2));

# --- Body assignment: closure sees assigned value; next cond sees post(assigned) ---
var assignedFn = func() { return 0; };
var nextIterVal = 0;
for (var i = 0; i < 5; i++) {
    if i == 0 {
        i = 3;
        assignedFn = func() { return i; };
    } else {
        nextIterVal = i;
    }
}
ok = ok && assignedFn() == 3 && nextIterVal == 4;

# --- continue still runs post; closures still per-iteration ---
var contFns = list.new();
for (var i = 0; i < 4; i++) {
    if i % 2 == 0 {
        contFns.append(func() { return i; });
        continue;
    }
    contFns.append(func() { return i; });
}
ok = ok && same(callAll(contFns), list.of(0, 1, 2, 3));

# --- continue after assigning the loop var ---
# Closures capture the live binding, not a snapshot at creation.
# iter 0: i=0; iter 1: seen while i=1, then i=3, continue, post => 4; iter 2: i=4
var skipFns = list.new();
var skipSeen = list.new();
for (var i = 0; i < 5; i++) {
    skipSeen.append(i);
    skipFns.append(func() { return i; });
    if i == 1 {
        i = 3;
        continue;
    }
}
ok = ok && same(skipSeen, list.of(0, 1, 4));
ok = ok && same(callAll(skipFns), list.of(0, 3, 4));

# --- break: post is skipped; earlier closures keep their iteration values ---
var breakFns = list.new();
for (var i = 0; i < 10; i++) {
    breakFns.append(func() { return i; });
    if i == 2 {
        break;
    }
}
ok = ok && same(callAll(breakFns), list.of(0, 1, 2));

# --- Outer / while-style names stay shared ---
var i = 0;
var sharedFns = list.new();
for (; i < 3; i++) {
    sharedFns.append(func() { return i; });
}
ok = ok && same(callAll(sharedFns), list.of(3, 3, 3));

var j = 0;
var whileFns = list.new();
for j < 3 {
    whileFns.append(func() { return j; });
    j++;
}
ok = ok && same(callAll(whileFns), list.of(3, 3, 3));

# --- for-in is already per-iteration ---
var inFns = list.new();
for x in list.of(0, 1, 2) {
    inFns.append(func() { return x; });
}
ok = ok && same(callAll(inFns), list.of(0, 1, 2));

# --- Nested C-style: each (r, c) pair is its own pair of bindings ---
var pairFns = list.new();
for (var r = 0; r < 2; r++) {
    for (var c = 0; c < 3; c++) {
        pairFns.append(func() { return r * 10 + c; });
    }
}
ok = ok && same(callAll(pairFns), list.of(0, 1, 2, 10, 11, 12));

# --- Nested C-style + for-in ---
var mixedFns = list.new();
for (var r = 0; r < 2; r++) {
    for x in list.of(1, 2) {
        mixedFns.append(func() { return r * 10 + x; });
    }
}
ok = ok && same(callAll(mixedFns), list.of(1, 2, 11, 12));

# --- Inner break does not smear outer/inner loop vars ---
var innerBreakFns = list.new();
for (var r = 0; r < 3; r++) {
    for (var c = 0; c < 5; c++) {
        innerBreakFns.append(func() { return r * 10 + c; });
        if c == 1 {
            break;
        }
    }
}
ok = ok && same(callAll(innerBreakFns), list.of(0, 1, 10, 11, 20, 21));

# --- Shared outer while-var + per-iteration inner C-style var ---
# After the loops, w is 2 for every closure; inner n stays 0 or 1.
var w = 0;
var mixedCapture = list.new();
for w < 2 {
    for (var n = 0; n < 2; n++) {
        mixedCapture.append(func() { return w * 10 + n; });
    }
    w++;
}
ok = ok && same(callAll(mixedCapture), list.of(20, 21, 20, 21));

# --- Nested closures: inner func still sees this iteration's i ---
var makers = list.new();
for (var i = 0; i < 3; i++) {
    makers.append(func() {
        return func() { return i * i; };
    });
}
ok = ok && makers[0]()() == 0 && makers[1]()() == 1 && makers[2]()() == 4;

# --- Factory: loop inside a function that returns the closures ---
const makeFns = func(n) {
    var fns = list.new();
    for (var i = 0; i < n; i++) {
        fns.append(func() { return i; });
    }
    return fns;
};
ok = ok && same(callAll(makeFns(4)), list.of(0, 1, 2, 3));

const makeGrid = func(rows, cols) {
    var cells = list.new();
    for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
            cells.append(func() { return r * 10 + c; });
        }
    }
    return cells;
};
ok = ok && same(callAll(makeGrid(2, 3)), list.of(0, 1, 2, 10, 11, 12));

# --- return inside the loop: post does not run; existing closures keep values ---
const takeTwo = func() {
    var fns = list.new();
    for (var i = 0; i < 10; i++) {
        fns.append(func() { return i; });
        if i == 1 {
            return fns;
        }
    }
    return fns;
};
ok = ok && same(callAll(takeTwo()), list.of(0, 1));

# --- Same name in a later loop does not rewrite earlier closures ---
var firstWave = list.new();
for (var i = 0; i < 2; i++) {
    firstWave.append(func() { return i; });
}
for (var i = 10; i < 12; i++) {
}
ok = ok && same(callAll(firstWave), list.of(0, 1));

# --- Per-iteration cell is mutable; sibling closures share it; other iterations do not ---
var mutFns = list.new();
for (var i = 0; i < 3; i++) {
    mutFns.append(func() {
        i = i + 1;
        return i;
    });
}
ok = ok && same(callAll(mutFns), list.of(1, 2, 3));
ok = ok && same(callAll(mutFns), list.of(2, 3, 4));

var siblings = list.new();
for (var i = 0; i < 1; i++) {
    siblings.append(func() {
        i = i + 10;
        return i;
    });
    siblings.append(func() { return i; });
}
ok = ok && siblings[0]() == 10 && siblings[1]() == 10;

# --- Closure captures loop var and an outer mutable ---
var scale = 1;
var scaledFns = list.new();
for (var i = 0; i < 3; i++) {
    scaledFns.append(func() { return i * scale; });
}
scale = 10;
ok = ok && same(callAll(scaledFns), list.of(0, 10, 20));

# --- Inner shadow of i does not change closures defined on the loop var ---
var shadowFns = list.new();
for (var i = 0; i < 3; i++) {
    shadowFns.append(func() { return i; });
    {
        var i = 99;
        i = 100;
    }
}
ok = ok && same(callAll(shadowFns), list.of(0, 1, 2));

# --- Closure defined in a shadowing block captures the inner binding ---
var innerShadowFns = list.new();
for (var i = 0; i < 3; i++) {
    {
        var i = 99;
        innerShadowFns.append(func() { return i; });
    }
}
ok = ok && same(callAll(innerShadowFns), list.of(99, 99, 99));

# --- Called during the loop and after: both see that iteration's value ---
var liveFns = list.new();
var during = list.new();
for (var i = 0; i < 3; i++) {
    liveFns.append(func() { return i; });
    during.append(liveFns[i]());
}
ok = ok && same(during, list.of(0, 1, 2));
ok = ok && same(callAll(liveFns), list.of(0, 1, 2));

ok
